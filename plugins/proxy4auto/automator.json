{
  "nodes": [
    {
      "type": "proxy",
      "name": "Proxy",
      "category": "Proxy",
      "desc": "O proxy inteiro num nó: ponha as rotas e execute. Fica no ar enquanto o fluxo roda, mostra o registro ao vivo e dispara o que estiver ligado nas saídas. Parou o fluxo, desliga.",
      "keywords": [
        "servidor",
        "ligar",
        "iniciar",
        "rota",
        "apontar",
        "nome local",
        "tempo real",
        "log",
        "requisição",
        "tcp",
        "banco"
      ],
      "takes": "any",
      "gives": "object",
      "inputs": [
        "in"
      ],
      "outputs": [
        "ligado",
        "requisicao",
        "erro"
      ],
      "port_labels": {
        "ligado": "ao ligar",
        "requisicao": "cada requisição",
        "erro": "cada erro"
      },
      "expects": "Qualquer dado. Dá para usar {{input}} nos campos. Sem rotas na tabela, usa o texto que chega (uma rota por linha).",
      "returns": "Saída \"ao ligar\": uma vez, com as rotas no ar. Saída \"cada requisição\": cada requisição que passa (rota, método, caminho, status, tempo, URL local e destino). Saída \"cada erro\": as que falharam (sem resposta ou status 500 ou mais).",
      "sample": {
        "rota": "localhost-api:80",
        "metodo": "GET",
        "caminho": "/v1/clientes",
        "status": 200,
        "ms": 143,
        "falhou": false,
        "url": "http://localhost-api/v1/clientes",
        "destino": "https://api.exemplo.com",
        "quando": "2026-11-16T12:01:00.000Z"
      },
      "params": {
        "rotas": [
          {
            "nome": "",
            "destino": "",
            "porta": ""
          }
        ],
        "porta_http": 80,
        "nomes": "nenhum",
        "reescrever_links": "sim",
        "registro": "tudo",
        "rede": "nao",
        "dns": "nao",
        "porta_ocupada": "falhar"
      },
      "fields": [
        {
          "name": "rotas",
          "label": "Rotas",
          "kind": "rows",
          "add": "Rota",
          "required": true,
          "help": "Destino: o site ou a API (https://api.exemplo.com). Nome local: como ele abre neste PC; vazio, sai do destino (localhost-api-exemplo). Para um banco ou outro serviço TCP, escreva tcp://host:porta no destino e a porta local.",
          "columns": [
            {
              "name": "destino",
              "placeholder": "https://api.exemplo.com"
            },
            {
              "name": "nome",
              "placeholder": "Nome local (vazio: sai do destino)"
            },
            {
              "name": "porta",
              "placeholder": "Porta local (vazio: a de baixo)"
            }
          ]
        },
        {
          "name": "porta_http",
          "label": "Porta dos nomes locais",
          "kind": "number",
          "min": 1,
          "max": 65535,
          "help": "Com a 80, a rota abre como http://nome. Com outra, como http://nome:porta."
        },
        {
          "name": "nomes",
          "label": "Nomes locais",
          "kind": "select",
          "options": [
            {
              "value": "nenhum",
              "label": "Não gravar no hosts"
            },
            {
              "value": "hosts",
              "label": "Gravar no hosts enquanto ligado (o Windows pergunta ao ligar)"
            }
          ],
          "help": "Sem gravar, os nós do Proxy já alcançam as rotas. Gravando, qualquer programa deste PC abre o nome local; o proxy tira os nomes ao desligar."
        },
        {
          "name": "reescrever_links",
          "label": "Reescrever links e apagar rastros",
          "kind": "select",
          "options": [
            {
              "value": "sim",
              "label": "Sim"
            },
            {
              "value": "nao",
              "label": "Não"
            }
          ],
          "help": "Troca no que vem do destino as URLs dele pelo endereço local e apaga rastros da Vercel e da Cloudflare."
        },
        {
          "name": "registro",
          "label": "Registro ao vivo",
          "kind": "select",
          "options": [
            {
              "value": "tudo",
              "label": "Cada requisição e os avisos"
            },
            {
              "value": "erros",
              "label": "Só o que deu errado"
            },
            {
              "value": "pouco",
              "label": "Só ligar e desligar"
            }
          ],
          "help": "O que aparece no nó e no painel enquanto o proxy roda."
        },
        {
          "name": "rede",
          "label": "Aceitar outros aparelhos da rede",
          "kind": "select",
          "options": [
            {
              "value": "nao",
              "label": "Não"
            },
            {
              "value": "sim",
              "label": "Sim"
            }
          ],
          "help": "Não: só este PC alcança as rotas."
        },
        {
          "name": "dns",
          "label": "DNS local",
          "kind": "select",
          "options": [
            {
              "value": "nao",
              "label": "Não"
            },
            {
              "value": "sim",
              "label": "Sim"
            }
          ],
          "help": "Um DNS em 127.0.0.1 que responde os nomes das rotas. Só serve junto com o nó Permissão de administrador (DNS do Windows pelo proxy)."
        },
        {
          "name": "porta_ocupada",
          "label": "Se uma porta estiver ocupada",
          "kind": "select",
          "options": [
            {
              "value": "falhar",
              "label": "Parar com erro (diz qual programa está nela)"
            },
            {
              "value": "esperar",
              "label": "Ligar assim mesmo e tentar a porta a cada 5 s"
            }
          ]
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 3600000,
        "hold": true,
        "stream": true
      }
    },
