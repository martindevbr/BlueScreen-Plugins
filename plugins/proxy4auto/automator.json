{
  "nodes": [
    {
      "type": "status",
      "name": "Proxy no ar?",
      "category": "Proxy",
      "desc": "Segue por sim quando o localhost-proxy está respondendo e por não quando está desligado. Diz também o que não subiu.",
      "keywords": [
        "status",
        "monitorar",
        "saúde",
        "rodando",
        "condição"
      ],
      "takes": "any",
      "gives": "object",
      "inputs": [
        "in"
      ],
      "outputs": [
        "true",
        "false"
      ],
      "expects": "Qualquer dado (não é usado).",
      "returns": "Se está no ar, a porta HTTP, DNS, hosts, quantas rotas, portas que não abriram, linhas recusadas do apontamentos.txt e a lista de problemas.",
      "sample": {
        "no_ar": true,
        "painel": "http://127.0.0.1:7070",
        "porta_http": 80,
        "dns": "ok",
        "hosts": "ok",
        "reescrever_links": true,
        "rotas_http": 2,
        "rotas_tcp": 1,
        "linhas_invalidas": [],
        "portas_sem_escutar": [],
        "problemas": []
      },
      "params": {
        "exigir": "no_ar"
      },
      "fields": [
        {
          "name": "exigir",
          "label": "Sim quando",
          "kind": "select",
          "options": [
            {
              "value": "no_ar",
              "label": "O proxy responde"
            },
            {
              "value": "inteiro",
              "label": "Responde e está tudo de pé (portas, DNS, rotas válidas)"
            }
          ]
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 30000
      }
    },
    {
      "type": "ligar",
      "name": "Ligar o proxy",
      "category": "Proxy",
      "desc": "Liga o localhost-proxy e espera o painel responder. Se ele já estiver no ar, só confirma.",
      "keywords": [
        "iniciar",
        "start",
        "subir",
        "abrir"
      ],
      "takes": "any",
      "gives": "object",
      "expects": "Qualquer dado (não é usado).",
      "returns": "Se ligou ou já estava ligado, a pasta, o modo, quantas rotas e avisos (portas ocupadas, hosts sem administrador).",
      "sample": {
        "ligado": true,
        "ja_estava": false,
        "painel": "http://127.0.0.1:7070",
        "pasta": "C:\\proxy-server",
        "modo": "normal",
        "rotas": 3,
        "avisos": []
      },
      "params": {
        "modo": "normal",
        "esperar_s": 30
      },
      "fields": [
        {
          "name": "modo",
          "label": "Como",
          "kind": "select",
          "options": [
            {
              "value": "normal",
              "label": "Normal (sem mexer no hosts se não tiver permissão)"
            },
            {
              "value": "admin",
              "label": "Como administrador (o Windows pergunta; grava o hosts)"
            }
          ],
          "help": "Sem administrador os nomes locais resolvem pelo DNS do proxy. Como administrador ele também escreve no hosts do Windows: o próprio BlueScreen pede a permissão, sem janela de console."
        },
        {
          "name": "esperar_s",
          "label": "Esperar até (segundos)",
          "kind": "number",
          "min": 5,
          "max": 120
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 140000
      }
    },
    {
      "type": "desligar",
      "name": "Desligar o proxy",
      "category": "Proxy",
      "desc": "Encerra o localhost-proxy que está escutando no painel. Confere antes que o processo é mesmo o proxy.js; se ele roda como administrador, o Windows pede a permissão para encerrar.",
      "keywords": [
        "parar",
        "stop",
        "encerrar",
        "fechar"
      ],
      "takes": "any",
      "gives": "object",
      "expects": "Qualquer dado (não é usado).",
      "returns": "Se desligou ou já estava desligado, o PID encerrado, se precisou de administrador e o que foi feito com o hosts.",
      "sample": {
        "desligado": true,
        "ja_estava": false,
        "pid": 12776,
        "como_administrador": true,
        "hosts": "bloco do proxy removido"
      },
      "params": {
        "hosts": "manter"
      },
      "fields": [
        {
          "name": "hosts",
          "label": "Arquivo hosts",
          "kind": "select",
          "options": [
            {
              "value": "manter",
              "label": "Deixar como está"
            },
            {
              "value": "limpar",
              "label": "Limpar o bloco do proxy (o Windows pergunta)"
            }
          ],
          "help": "Encerrado de fora, o proxy não tira o bloco dele do hosts, e os nomes locais ficam apontando para 127.0.0.1 sem ninguém atender."
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 60000
      }
    },
    {
      "type": "admin",
      "name": "Permissão de administrador",
      "category": "Proxy",
      "desc": "Ao executar, pede a permissão de administrador do Windows. Aceita, faz a ação escolhida e segue por sim; recusada, segue por não.",
      "keywords": [
        "administrador",
        "elevar",
        "uac",
        "permissão",
        "dns",
        "hosts",
        "runas"
      ],
      "takes": "any",
      "gives": "object",
      "inputs": [
        "in"
      ],
      "outputs": [
        "true",
        "false"
      ],
      "expects": "Qualquer dado. Em Rodar um programa, se o campo Programa ficar vazio, usa o texto que chega.",
      "returns": "A ação, se a permissão foi dada, o resultado e, nas ações de DNS, cada adaptador com o DNS de antes ou o de agora.",
      "sample": {
        "acao": "dns_proxy",
        "permitido": true,
        "resultado": "o Windows agora resolve nomes pelo proxy",
        "adaptadores": [
          {
            "adaptador": "Ethernet",
            "antes": "192.168.0.1"
          }
        ]
      },
      "params": {
        "acao": "nada",
        "motivo": "",
        "programa": "",
        "argumentos": "",
        "pasta": ""
      },
      "fields": [
        {
          "name": "acao",
          "label": "Depois de permitido",
          "kind": "select",
          "options": [
            {
              "value": "nada",
              "label": "Só confirmar (seguir por sim)"
            },
            {
              "value": "hosts",
              "label": "Limpar o bloco do proxy no hosts"
            },
            {
              "value": "dns_proxy",
              "label": "DNS do Windows pelo proxy (sem mexer no hosts)"
            },
            {
              "value": "dns_restaurar",
              "label": "Restaurar o DNS do Windows"
            },
            {
              "value": "programa",
              "label": "Rodar um programa como administrador"
            }
          ],
          "help": "DNS pelo proxy: os adaptadores ligados passam a usar 127.0.0.1, guardando o DNS de antes para Restaurar. Só roda com o DNS do proxy no ar, senão a internet do PC para."
        },
        {
          "name": "motivo",
          "label": "Motivo",
          "kind": "text",
          "placeholder": "Opcional: aparece no resultado e no histórico"
        },
        {
          "name": "programa",
          "label": "Programa",
