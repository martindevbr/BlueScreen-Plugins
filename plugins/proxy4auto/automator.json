          "pick": "program",
          "placeholder": "Vazio: o texto que chega",
          "show": {
            "acao": [
              "programa"
            ]
          }
        },
        {
          "name": "argumentos",
          "label": "Argumentos",
          "kind": "text",
          "placeholder": "Entre aspas o que tiver espaço",
          "show": {
            "acao": [
              "programa"
            ]
          }
        },
        {
          "name": "pasta",
          "label": "Rodar na pasta",
          "kind": "text",
          "pick": "folder",
          "show": {
            "acao": [
              "programa"
            ]
          }
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 200000
      }
    },
