      "keywords": [
        "criar rota",
        "adicionar",
        "mapear",
        "apontamento",
        "tcp",
        "banco"
      ],
      "takes": "any",
      "gives": "object",
      "expects": "O destino. Se o campo Destino ficar vazio, usa o texto que chega (ou o campo url de um objeto).",
      "returns": "Se criou ou mudou, a rota, o endereço local e, com Testar, se o destino respondeu.",
      "sample": {
        "criada": true,
        "mudou": true,
        "rota": {
          "id": "localhost-api-meucliente:80",
          "tipo": "http",
          "nome": "localhost-api-meucliente",
          "porta": 80,
          "local": "http://localhost-api-meucliente",
          "destino": "https://api.meucliente.com.br"
        },
        "local": "http://localhost-api-meucliente",
        "teste": {
          "ok": true,
          "status": 200,
          "ms": 210
        }
      },
      "params": {
        "tipo": "http",
        "destino": "",
        "nome": "",
        "porta": "",
        "se_existir": "falhar",
        "testar": "sim"
      },
      "fields": [
        {
          "name": "tipo",
          "label": "Tipo",
          "kind": "select",
          "options": [
            {
              "value": "http",
              "label": "HTTP (site ou API, por nome)"
            },
            {
              "value": "tcp",
              "label": "TCP (banco, Redis… por porta)"
            }
          ]
        },
        {
          "name": "destino",
          "label": "Destino",
          "kind": "text",
          "placeholder": "https://api.exemplo.com",
          "help": "No TCP: host:porta, como 203.0.113.10:5432."
        },
        {
          "name": "nome",
          "label": "Nome local",
          "kind": "text",
          "placeholder": "Vazio: um nome tirado do destino",
          "show": {
            "tipo": [
              "http"
            ]
          },
          "help": "Vazio, https://api.meucliente.com.br vira localhost-api-meucliente."
        },
        {
          "name": "porta",
          "label": "Porta local",
          "kind": "text",
          "placeholder": "Vazio: a porta_http do proxy",
          "help": "No HTTP, outra porta faz o proxy escutar nela também (http://nome:porta). No TCP é obrigatória."
        },
        {
          "name": "se_existir",
          "label": "Se já existir com outro destino",
          "kind": "select",
          "options": [
            {
              "value": "falhar",
              "label": "Parar com erro"
            },
            {
              "value": "trocar",
              "label": "Trocar o destino"
            }
          ]
        },
        {
          "name": "testar",
          "label": "Testar o destino depois",
          "kind": "select",
          "options": [
            {
              "value": "sim",
              "label": "Sim"
            },
            {
              "value": "nao",
              "label": "Não"
            }
          ]
        }
      ],
      "run": {
        "program": "node",
        "args": [
          "nos.mjs"
        ],
        "timeout": 60000
