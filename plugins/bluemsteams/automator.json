        { "name": "question", "label": "Pergunta", "kind": "text", "placeholder": "Posso publicar a versão 2.14.0 em produção?", "show": { "model": ["aprovacao"] } },
        { "name": "app", "label": "Aplicação", "kind": "text", "show": { "model": ["deploy"] } },
        { "name": "version", "label": "Versão", "kind": "text", "show": { "model": ["deploy"] } },
        { "name": "result", "label": "Resultado", "kind": "select", "show": { "model": ["deploy"] }, "options": [
          { "value": "ok", "label": "Sucesso" }, { "value": "falha", "label": "Falhou" }, { "value": "andamento", "label": "Em andamento" }, { "value": "rollback", "label": "Rollback" } ] },
        { "name": "severity", "label": "Severidade", "kind": "select", "show": { "model": ["incidente"] }, "options": [
          { "value": "sev1", "label": "SEV1 · Crítico" }, { "value": "sev2", "label": "SEV2 · Alto" }, { "value": "sev3", "label": "SEV3 · Médio" }, { "value": "sev4", "label": "SEV4 · Baixo" } ] },
        { "name": "state", "label": "Estado", "kind": "select", "show": { "model": ["incidente"] }, "options": [
          { "value": "Aberto", "label": "Aberto" }, { "value": "Investigando", "label": "Investigando" }, { "value": "Mitigado", "label": "Mitigado" }, { "value": "Resolvido", "label": "Resolvido" } ] },
        { "name": "service", "label": "Serviço afetado", "kind": "text", "show": { "model": ["incidente"] } },
        { "name": "passed", "label": "Passaram", "kind": "text", "placeholder": "{{input.passed}}", "show": { "model": ["testes"] } },
        { "name": "failed", "label": "Falharam", "kind": "text", "placeholder": "{{input.failed}}", "show": { "model": ["testes"] } },
        { "name": "skipped", "label": "Ignorados", "kind": "text", "placeholder": "{{input.skipped}}", "show": { "model": ["testes"] } },
        { "name": "env", "label": "Ambiente", "kind": "text", "placeholder": "produção", "show": { "model": ["testes", "deploy"] } },
        { "name": "duration", "label": "Duração", "kind": "text", "placeholder": "4 min 12 s", "show": { "model": ["testes"] } },
        { "name": "text", "label": "Texto", "kind": "area", "show": { "model": ["incidente", "deploy", "aprovacao", "livre"] } },
        { "name": "failures", "label": "Falhas (uma por linha)", "kind": "area", "show": { "model": ["testes"] } },
        { "name": "owner", "label": "Responsável", "kind": "text", "show": { "model": ["incidente", "deploy"] } },
        { "name": "link", "label": "Link do botão", "kind": "text", "placeholder": "https://…", "show": { "model": ["incidente", "testes", "deploy"] } },
        { "name": "warroom", "label": "Link da war room", "kind": "text", "placeholder": "{{nodes.reuniao.link}}", "show": { "model": ["incidente"] } },
        { "name": "yes_url", "label": "Link do botão Aprovar", "kind": "text", "placeholder": "https://…", "show": { "model": ["aprovacao"] }, "help": "Por webhook o botão só abre um link. Um fluxo com o gatilho Endpoint HTTP dá um link que registra a resposta. Sem link, use o nó Esperar resposta." },
        { "name": "no_url", "label": "Link do botão Recusar", "kind": "text", "placeholder": "https://…", "show": { "model": ["aprovacao"] } },
        { "name": "hint", "label": "Como responder", "kind": "text", "show": { "model": ["aprovacao"] } },
        { "name": "color", "label": "Cor da faixa", "kind": "select", "show": { "model": ["livre"] }, "options": [
          { "value": "accent", "label": "Azul" }, { "value": "good", "label": "Verde" }, { "value": "warning", "label": "Amarelo" }, { "value": "attention", "label": "Vermelho" }, { "value": "emphasis", "label": "Cinza" } ] },
        { "name": "facts", "label": "Campos", "kind": "rows", "add": "Campo", "show": { "model": ["livre"] }, "columns": [{ "name": "name", "placeholder": "Nome" }, { "name": "value", "placeholder": "Valor" }] },
        { "name": "buttons", "label": "Botões", "kind": "rows", "add": "Botão", "show": { "model": ["livre"] }, "columns": [{ "name": "name", "placeholder": "Rótulo" }, { "name": "value", "placeholder": "https://…" }] },
        { "name": "mention", "label": "Mencionar", "kind": "text", "placeholder": "ana@empresa.com, joao@empresa.com" }
      ],
      "run": { "program": "node", "args": ["nos.mjs"], "timeout": 180000 }
    },
