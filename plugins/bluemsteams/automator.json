      "params": { "to": "", "model": "incidente", "title": "", "severity": "sev2", "state": "Aberto", "service": "", "question": "", "app": "", "version": "", "env": "", "result": "ok", "passed": "", "failed": "", "skipped": "", "duration": "", "text": "", "failures": "", "owner": "", "link": "", "warroom": "", "yes_url": "", "no_url": "", "hint": "Responda nesta conversa com \"aprovado\" ou \"recusado\".", "color": "accent", "facts": [], "buttons": [], "mention": "" },
      "fields": [
        { "name": "to", "label": "Destino", "kind": "text", "choicesFrom": "bluemsteams/opcoes?aceita=webhook,canal,chat", "placeholder": "incidentes", "help": "Escolha na lista: os destinos salvos no painel Teams e, com a conta Microsoft, os canais dos seus times e os seus chats. Em Outro…, cole o link do canal ou escreva os e-mails das pessoas." },
        { "name": "model", "label": "Modelo", "kind": "select", "options": [
          { "value": "incidente", "label": "Alerta de incidente" }, { "value": "testes", "label": "Resultado de testes" }, { "value": "deploy", "label": "Deploy" },
          { "value": "aprovacao", "label": "Pedido de aprovação" }, { "value": "livre", "label": "Personalizado" } ] },
