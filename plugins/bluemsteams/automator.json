      "params": { "to": "", "title": "", "text": "{{input}}", "mention": "" },
      "fields": [
        { "name": "to", "label": "Webhook", "kind": "text", "choicesFrom": "bluemsteams/opcoes?aceita=webhook", "placeholder": "incidentes", "help": "Os webhooks salvos no painel Teams. A URL fica guardada no plugin, não no fluxo. Em Outro…, vale {{cred:nome}} com a URL guardada em Credenciais." },
        { "name": "title", "label": "Título", "kind": "text", "placeholder": "vazio: sem título" },
        { "name": "text", "label": "Mensagem", "kind": "area" },
        { "name": "mention", "label": "Mencionar", "kind": "text", "placeholder": "ana@empresa.com, joao@empresa.com" }
      ],
      "run": { "program": "node", "args": ["nos.mjs"], "timeout": 180000 }
    },
    {
      "type": "cartao", "name": "Enviar cartão", "category": "Teams",
